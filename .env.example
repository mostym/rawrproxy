# Server Configuration
PORT=8080
ADMIN_PORT=8081
NODE_ENV=production

# Proxy Modes
ENABLE_FORWARD_PROXY=true
ENABLE_REVERSE_PROXY=true

# SSL/TLS Configuration
HTTPS_ENABLED=true
SSL_CERT_PATH=./certs/cert.pem
SSL_KEY_PATH=./certs/key.pem

# Authentication
JWT_SECRET=your-secret-key-change-this
AUTH_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Caching
CACHE_ENABLED=true
CACHE_TTL=300
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs/proxy.log

# Database
DATABASE_PATH=./data/proxy.db

# Reverse Proxy Targets (comma-separated)
REVERSE_PROXY_TARGETS=http://backend1:3000,http://backend2:3000

# Blocked Domains (comma-separated)
BLOCKED_DOMAINS=example.com,badsite.com

# WebSocket Support
WEBSOCKET_ENABLED=true

# Redis Cache Configuration
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=yourpassword
REDIS_DB=0

# WAF (Web Application Firewall)
WAF_ENABLED=true
WAF_LOG_ONLY=false
WAF_VERBOSE=false

# Monitoring
METRICS_ENABLED=true
METRICS_PORT=9090

# Circuit Breaker Configuration
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_ERROR_THRESHOLD=50
CIRCUIT_BREAKER_RESET_TIMEOUT=30000