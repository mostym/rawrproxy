# Server Configuration
PORT=8080
ADMIN_PORT=8081
NODE_ENV=production

# Proxy Modes
ENABLE_FORWARD_PROXY=true
ENABLE_REVERSE_PROXY=true

# SSL/TLS Configuration
HTTPS_ENABLED=true
SSL_CERT_PATH=./certs/cert.pem
SSL_KEY_PATH=./certs/key.pem

# Authentication
JWT_SECRET=your-secret-key-change-this
AUTH_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Caching
CACHE_ENABLED=true
CACHE_TTL=300
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs/proxy.log

# Database
DATABASE_PATH=./data/proxy.db

# Reverse Proxy Targets (comma-separated)
REVERSE_PROXY_TARGETS=http://backend1:3000,http://backend2:3000

# Blocked Domains (comma-separated)
BLOCKED_DOMAINS=example.com,badsite.com

# WebSocket Support
WEBSOCKET_ENABLED=true